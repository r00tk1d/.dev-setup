# launch apps
alias lg="lazygit"
alias c="code ."
alias hr="herdr"

if [[ "$OSTYPE" == darwin* ]]; then
    alias cpy="pbcopy"
    alias pst="pbpaste"
    alias o="open"
else
    alias cpy="wl-copy"
    alias pst="wl-paste"
    alias o="xdg-open"
fi

# git
alias gs="git status"
alias gd="git diff"
alias ga="git add"
alias gaa="git add --all"
alias gc="git commit"
alias gcm="git commit -m"
alias gca="git commit --amend"
alias gcaf="gca --no-edit --force-with-lease"
alias gpo="git push origin"
alias gpof="gpo --force-with-lease"
alias grs="git reset --soft HEAD~1"
alias grh="git reset --hard HEAD"
alias gl="git log --oneline --graph --decorate"
alias glg="log --color --graph --pretty=format:'%Cred%h%Creset-%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit"
alias gco="git checkout"
alias gcb="git checkout -b"
alias gb="git branch"
alias gbr="git branch -v"
alias gbd="git branch -d"
alias gbdf="git branch -D"
alias gbdall='f() { git branch -d "$1" && git push origin --delete "$1"; }; f'
alias gbn="git branch -m"
alias gst="git stash"
alias gstp="git stash pop"
alias gstl="git stash list"
alias gsts="git stash show -p"
alias gstc="git stash clear"
alias gcp="git cherry-pick"
alias gpf="git pull origin"
alias gf="git fetch --all --prune"
alias gps="git push"
alias gpsf="git push --force-with-lease"
alias grb="git rebase"
alias grba="git rebase --abort"
alias grbc="git rebase --continue"

# Create and cd into a directory with subdirectories
alias mdir='f() { mkdir -p "$1" && cd "$1"; }; f'

# print current unix timestamp with 3 milliseconds
alias now="python3 -c 'import time; print(int(time.time() * 1000))'"

# Use zoxide instead of cd
alias cd="z"

# notes
alias notes="vim $HOME/.notes.md"

# scripts
alias timer="timer.sh"
alias uptimes="uptimes.sh"
alias cr="code-review.sh"