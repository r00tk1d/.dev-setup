alias lg="lazygit"
alias c="code ."
alias hr="herdr"

if [[ "$OSTYPE" == darwin* ]]; then
    alias cpy="pbcopy"
    alias pst="pbpaste"
    alias o="open"
else
    alias cpy="xclip -selection clipboard"
    alias pst="xclip -selection clipboard -o"
    alias o="xdg-open"
    alias bat="batcat"
fi

# git
alias grs="git reset --soft HEAD~1"

# Create and cd into a directory with subdirectories
alias mdir='f() { mkdir -p "$1" && cd "$1"; }; f'

# print current unix timestamp with 3 milliseconds
alias now="python3 -c 'import time; print(int(time.time() * 1000))'"

# Use zoxide instead of cd
alias cd="z"

# notes
alias notes="vim $HOME/.notes.md"

# scripts
alias timer="timer.sh"
alias uptimes="uptimes.sh"
alias cr="code-review.sh"